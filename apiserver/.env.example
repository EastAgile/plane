# Django
DEBUG=1
DJANGO_SETTINGS_MODULE=plane.settings.local

# Database
POSTGRES_USER=plane
POSTGRES_PASSWORD=plane
POSTGRES_DB=plane
POSTGRES_HOST=plane-db
POSTGRES_PORT=5432
DATABASE_URL=

# Redis
REDIS_URL=redis://plane-redis:6379/

# RabbitMQ
RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=plane
RABBITMQ_VHOST=plane
AMQP_URL=

# Object Storage (MinIO)
USE_MINIO=1
AWS_REGION=
AWS_ACCESS_KEY_ID=access-key
AWS_SECRET_ACCESS_KEY=secret-key
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
FILE_SIZE_LIMIT=5242880

# Application URLs
WEB_URL=http://localhost:9999
CORS_ALLOWED_ORIGINS=http://localhost:9999
APP_BASE_URL=http://localhost:9999
ADMIN_BASE_URL=http://localhost:9999/god-mode/
SPACE_BASE_URL=http://localhost:9999/spaces/

# Sentry (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Gunicorn
GUNICORN_WORKERS=1

# Secret Key (auto-generated by setup.sh)
# SECRET_KEY=
